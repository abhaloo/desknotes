# DeskNotes reads these from the environment. On Windows, save each one as a
# user variable (setx NAME "value"); DeskNotes also reads user variables that
# were saved after your terminal opened. The four API keys can go in keys.env
# in the DeskNotes data folder instead (Settings > Edit keys…), and a key there
# wins over the environment. Never commit real values.

# Speech to text (Whisper large v3 turbo). Needed for live transcripts.
GROQ_API_KEY=

# The default answer model, screen analysis and Terms.
DEEPSEEK_API_KEY=

# Optional: Qwen on Cerebras, the fastest answer model.
CEREBRAS_API_KEY=

# Optional: the judge that decides when a question is complete.
TYPESAFE_API_KEY=

# Optional: which prompt set in prompts/ to use (default: sales).
PROMPT_SET=
